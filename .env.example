# Plantilla de variables de entorno del API. SIN VALORES.
# Copiar a .env y completar. El .env real nunca se versiona.

# Servidor
PORT=
NODE_ENV=

# Base de datos MySQL
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_DATABASE=

# Autenticacion
JWT_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_APROBACION=

# Almacenamiento de archivos (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# CORS (opcional; lista separada por comas)
CORS_ORIGIN=

# Control de acceso por sucursal: "enforce" (default) o "log" (solo loguea, no bloquea)
SUCURSAL_ACCESS_MODE=

# Alertas de RRHH (opcionales; tienen default en codigo)
RRHH_ALERTA_VENCIMIENTOS_DIAS_ANTES=
RRHH_ALERTA_PERIODO_PRUEBA_DIAS_ANTES=
RRHH_ALERTA_LEGAJOS_DIAS_ANTES=
RRHH_ALERTA_ESCALAS_MESES_SIN_ACTUALIZAR=
RRHH_PERIODO_PRUEBA_DIAS=
RRHH_RESPONSABLE_EMAIL=
